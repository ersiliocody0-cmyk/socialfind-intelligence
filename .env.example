# SocialFind Intelligence - Environment Variables Configuration

# Application Metadata
NEXT_PUBLIC_APP_NAME="SocialFind Intelligence"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SERP Engine Selection: "google_cse" | "serper" | "demo"
SERP_PROVIDER="demo"
ENABLE_DEMO_FALLBACK="true"

# Google Programmable Search Engine (CSE)
# Obtain from https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# Alternative: Serper.dev Google SERP API
# Obtain from https://serper.dev/
SERPER_API_KEY=""

# Supabase Storage & Authentication (Optional, in-memory/local storage used as zero-config fallback)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
